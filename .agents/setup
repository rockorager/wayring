#!/bin/sh
set -eu

version=0.16.0
install_dir="$HOME/.local/zig/$version"
bin_dir="$HOME/.local/bin"

if ! pkg-config --exists wayland-client wayland-server wayland-protocols 2>/dev/null ||
    ! command -v strace >/dev/null 2>&1 ||
    ! command -v perf >/dev/null 2>&1; then
    sudo apt-get update
    sudo apt-get install -y libwayland-dev linux-perf pkg-config strace wayland-protocols
fi

case "$(uname -m)" in
    x86_64)
        arch=x86_64
        sha256=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
        ;;
    aarch64)
        arch=aarch64
        sha256=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17
        ;;
    *)
        echo "unsupported setup architecture: $(uname -m)" >&2
        exit 1
        ;;
esac

if [ ! -x "$install_dir/zig" ]; then
    archive=$(mktemp)
    trap 'rm -f "$archive"' EXIT
    curl --proto '=https' --tlsv1.2 -sSfL \
        "https://ziglang.org/download/$version/zig-$arch-linux-$version.tar.xz" \
        -o "$archive"
    echo "$sha256  $archive" | sha256sum -c -
    mkdir -p "$install_dir"
    tar -xJf "$archive" --strip-components=1 -C "$install_dir"
fi

mkdir -p "$bin_dir"
ln -sfn "$install_dir/zig" "$bin_dir/zig"
